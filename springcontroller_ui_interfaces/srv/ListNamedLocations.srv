# Lists all saved named locations. Parallel arrays (same convention as
# ListLinkNames) rather than a nested message type -- offset_x/y/z[i] is
# location names[i]'s world-frame offset from link_names[i]'s current
# position.
---
bool success
string message
string[] names
string[] link_names
float64[] offset_x
float64[] offset_y
float64[] offset_z
