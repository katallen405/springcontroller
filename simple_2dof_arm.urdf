<?xml version="1.0"?>
<robot name="simple_2dof_arm">

  <!-- World / fixed base -->
  <link name="world"/>

  <link name="base_link">
    <visual>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Link 1: 0.5m long, hangs along -Z at zero config -->
  <link name="link_1">
    <visual>
      <geometry><cylinder radius="0.02" length="0.5"/></geometry>
      <origin xyz="0 0 -0.25" rpy="0 0 0"/>
    </visual>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 -0.25"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Joint 1: revolute around Y axis (rotation in XZ plane) at origin -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="10"/>
  </joint>

  <!-- Link 2: 0.5m long -->
  <link name="link_2">
    <visual>
      <geometry><cylinder radius="0.015" length="0.5"/></geometry>
      <origin xyz="0 0 -0.25" rpy="0 0 0"/>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 -0.25"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.0005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Joint 2: revolute around Y axis at tip of link_1 -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 -0.5" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="10"/>
  </joint>

  <!-- End effector frame at tip of link_2 -->
  <link name="end_effector"/>
  <joint name="joint_end_effector" type="fixed">
    <parent link="link_2"/>
    <child link="end_effector"/>
    <origin xyz="0 0 -0.5" rpy="0 0 0"/>
  </joint>

</robot>
