<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>virtual_spring_ros2</name>
  <version>0.1.0</version>
  <description>
    Virtual spring impedance controller for robot arms.
    Computes joint torques from a set of virtual springs attached to arm links,
    each pulling toward a target point in world space.
  </description>

  <maintainer email="you@example.com">Your Name</maintainer>
  <license>MIT</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- ROS dependencies -->
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>      <!-- JointState -->
  <depend>geometry_msgs</depend>    <!-- PointStamped for spring targets -->
  <depend>std_srvs</depend>         <!-- SetBool for enable/disable -->
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Python deps (resolved at runtime via rosdep) -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pinocchio</exec_depend>

  <!-- Test dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
