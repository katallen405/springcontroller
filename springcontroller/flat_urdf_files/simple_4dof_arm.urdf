<?xml version="1.0"?>
<robot name="simple_4dof_arm">

  <!-- World / fixed base -->
  <link name="world"/>

  <link name="base_link">
    <visual>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Four identical 0.4m links, each hanging along -Z at zero config,
       chained end to end -- a straightforward extension of
       simple_2dof_arm.urdf to exercise localization across a longer,
       non-adjacent chain (test/test_press_to_pin.py's regression and
       ambiguity tests need at least 4 links: candidates 2 apart in the
       chain, e.g. link_2/link_4, to exercise the non-adjacent-ambiguity
       path). -->

  <link name="link_1">
    <visual>
      <geometry><cylinder radius="0.02" length="0.4"/></geometry>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
    </visual>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 -0.2"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="10"/>
  </joint>

  <link name="link_2">
    <visual>
      <geometry><cylinder radius="0.02" length="0.4"/></geometry>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
    </visual>
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0 0 -0.2"/>
      <inertia ixx="0.015" iyy="0.015" izz="0.0008" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 -0.4" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="10"/>
  </joint>

  <link name="link_3">
    <visual>
      <geometry><cylinder radius="0.018" length="0.4"/></geometry>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
    </visual>
    <inertial>
      <mass value="0.6"/>
      <origin xyz="0 0 -0.2"/>
      <inertia ixx="0.012" iyy="0.012" izz="0.0006" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 -0.4" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="10"/>
  </joint>

  <link name="link_4">
    <visual>
      <geometry><cylinder radius="0.015" length="0.4"/></geometry>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
    </visual>
    <inertial>
      <mass value="0.4"/>
      <origin xyz="0 0 -0.2"/>
      <inertia ixx="0.008" iyy="0.008" izz="0.0004" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0 -0.4" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="10"/>
  </joint>

  <!-- End effector frame at tip of link_4 -->
  <link name="end_effector"/>
  <joint name="joint_end_effector" type="fixed">
    <parent link="link_4"/>
    <child link="end_effector"/>
    <origin xyz="0 0 -0.4" rpy="0 0 0"/>
  </joint>

</robot>
