# rest_length/inner_radius/outer_radius only apply to a position spring
# (VirtualSpring) -- ignored (not an error) when updating a joint or
# orientation spring, same as AddSpring's fields of the same name being
# unused outside VirtualSpring's own constructor.
string name
float64 stiffness
float64 damping
float64 rest_length
float64 inner_radius
float64 outer_radius
---
bool success
string message
